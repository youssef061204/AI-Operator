# Reference only. The supported runtime reads process environment, not .env files.
# PowerShell example: $env:OPERATOR_MODEL = 'qwen2.5:7b-instruct'
OPERATOR_MODEL=qwen2.5:7b-instruct
OPERATOR_MODEL_URL=http://127.0.0.1:11434
OPERATOR_PORT=7788
# OPERATOR_WORKSPACE=C:\path\to\project
# OPERATOR_DATA_DIR=C:\path\to\private\operator-data
# OPERATOR_API_TOKEN=use-a-random-token-of-at-least-32-characters
# OPERATOR_FALLBACK_MODEL=another-installed-model
# OPERATOR_FALLBACK_URL=http://127.0.0.1:11434
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:7788